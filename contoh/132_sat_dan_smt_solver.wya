// Contoh Program Widya-Lang: Pilar Gelombang 57 - SAT Solver (DPLL) & SMT Linear Solver (SMT-LIB2)
// Demonstrasi pemecahan formula logika Boolean CNF dan pembuktian kendala aritmetika real linear.

tulis("=== [WIDYA VERIFIKASI FORMAL] SAT & SMT LINEAR SOLVER ===");

// 1. Pemecah Masalah Kepuasan Boolean (SAT DPLL)
// Formula CNF: (x1 OR x2) AND (NOT x1 OR x3) AND (NOT x2 OR NOT x3)
var sat = PemecahSAT();
sat_tambah_klausa(sat, [1, 2]);       // (x1 OR x2)
sat_tambah_klausa(sat, [-1, 3]);      // (NOT x1 OR x3)
sat_tambah_klausa(sat, [-2, -3]);     // (NOT x2 OR NOT x3)

var apakah_sat = sat_selesaikan_dpll(sat);
tulis("--- HASIL SOLVER SAT DPLL ---");
tulis("Apakah Formula CNF SAT? : " + apakah_sat);

var model_sat = sat_ambil_model(sat);
tulis("Model Penugasan Nilai Kebenaran (Satisfying Assignment):");
tulis("  x1 = " + model_sat["x1"]);
tulis("  x2 = " + model_sat["x2"]);
tulis("  x3 = " + model_sat["x3"]);

// 2. Pemecah Teori Linear SMT (Satisfiability Modulo Theories - QF_LRA)
tulis("\n--- PEMBUKTI KENDALA ARITMETIKA LINEAR (SMT) ---");
var smt = PemecahSMT("QF_LRA");

// Daftarkan variabel kontinu real
smt_tambah_variabel(smt, "tegangan", "Real");
smt_tambah_variabel(smt, "arus", "Real");

// Tambahkan kendala linear: tegangan >= 3.0 dan tegangan <= 5.0
smt_tambah_kendala(smt, "tegangan", ">=", 3.0);
smt_tambah_kendala(smt, "tegangan", "<=", 5.0);

var status_smt = smt_periksa_kepuasan(smt);
tulis("Status Kepuasan Kendala SMT: " + status_smt);

// Ekspor ke format standar skrip SMT-LIB2
var skrip_smtlib = smt_ekspor_smtlib2(smt);
tulis("\n--- DOKUMEN STANDAR SMT-LIB2 ---");
tulis(skrip_smtlib);

tulis("[WIDYA VERIFIKASI FORMAL] SAT & SMT Solver Berhasil Diverifikasi!");
