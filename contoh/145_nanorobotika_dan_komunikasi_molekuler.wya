// Contoh Program Widya-Lang: Pilar Gelombang 63 - Nanorobotika Biomedis & Komunikasi Molekuler (MolCom)
// Demonstrasi kawanan nanorobot kemotaksis untuk penghantaran obat terarah dan modulasi sinyal difusi CSK.

tulis("=== [WIDYA NANOROBOTIKA] KAWANAN MEDIS & KOMUNIKASI MOLEKULER ===");

// 1. Kawanan Nanorobot Biomedis (Targeted Drug Delivery & Chemotaxis)
tulis("--- KAWANAN NANOROBOT PENGHANTAR OBAT KANKER ---");
var swarm = KawananNanorobot(5000.0, 200.0); // 5000 nanorobot, radius 200 nm

// Atur Kondisi Hidrodinamika Pembuluh Darah
nanorobot_atur_pembuluh_darah(swarm, 2000.0, 120.0); // Aliran 120 um/s

// Daftarkan Lokasi Target Sel Tumor (Gradien Konsentrasi Biomarker)
nanorobot_tambah_target_tumor(swarm, 850.0, 1.0);

// Jalankan Simulasi Kemotaksis & Injeksi Muatan Obat (15 Detik)
var hasil_medis = nanorobot_langkah_kemotaksis_dan_injeksi(swarm, 0.1, 15.0);
tulis("Nanorobot Tiba di Target : " + hasil_medis["nanorobot_sampai_target"] + " unit");
tulis("Efisiensi Penghantaran   : " + hasil_medis["efisiensi_penghantaran_persen"] + "%");
tulis("Dosis Obat Terinjeksi    : " + hasil_medis["dosis_obat_terinjeksi_ug"] + " ug");
tulis("Status Medis             : " + hasil_medis["status_medis"]);

// 2. Jaringan Komunikasi Molekuler (Molecular Communication CSK)
tulis("\n--- JARINGAN KOMUNIKASI MOLEKULER BERBASIS DIFUSI (MOLCOM) ---");
var molcom = JaringanKomunikasiMolekuler(0.00000000042, 25.0); // D = 4.2e-10 m2/s, jarak 25 um

// Kirimkan Aliran Bit Biner Menggunakan Concentration Shift Keying (CSK)
var transmisi = molcom_kirim_sinyal_csk(molcom, "1011001", 20000.0);
tulis("Modulasi Transmisi      : " + transmisi["modulasi"]);
tulis("Panjang Bit Terkirim    : " + transmisi["panjang_bit"] + " bit");
tulis("Jumlah Molekul per Bit-1: " + transmisi["molekul_per_bit1"]);

// Hitung Probabilitas Deteksi & Bit Error Rate di Receiver Mikroskopis
var deteksi = molcom_hitung_probabilitas_deteksi(molcom, 300.0);
tulis("\nMolekul Terdeteksi di Rx: " + deteksi["molekul_terdeteksi_rx"]);
tulis("Bit Error Rate (BER)    : " + deteksi["bit_error_rate"]);
tulis("Kualitas Kanal Nanonet  : " + deteksi["kualitas_kanal_nano"]);

tulis("\n[WIDYA NANOROBOTIKA] Nanorobot Swarm & MolCom Berhasil Diverifikasi!");
