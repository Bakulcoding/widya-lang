// ==============================================================================
// CONTOH 14: MESIN DATABASE ENGINE ASLI DI WIDYA-LANG (WidyaDB)
// Mendukung:
// 1. Relational SQL Table (seperti PostgreSQL)
// 2. Document NoSQL Store (seperti MongoDB)
// 3. Persistent Disk Engine (Write-Ahead Log & Storage)
// ==============================================================================

cetak("===============================================================");
cetak("🗄️  DEMO MESIN DATABASE WIDYADB (PostgreSQL & MongoDB Engine)");
cetak("===============================================================\n");

// -----------------------------------------------------------------
// 1. STRUKTUR MESIN TABEL RELASIONAL (PostgreSQL-like SQL Table)
// -----------------------------------------------------------------
struktur TabelRelasional {
    nama_tabel,
    kolom,
    baris_data,
    indeks_pk,

    fungsi inisialisasi(nama, daftar_kolom) {
        ini.nama_tabel = nama;
        ini.kolom = daftar_kolom;
        ini.baris_data = [];
        ini.indeks_pk = {};
    }

    // INSERT INTO tabel VALUES (...)
    fungsi sisip(data_record) {
        misal id = data_record["id"];
        jika ada_kunci(ini.indeks_pk, ke_teks(id)) {
            kembalikan Err("Galat SQL: Kunci Utama (Primary Key) " + ke_teks(id) + " sudah ada!");
        }
        
        tambah(ini.baris_data, data_record);
        ini.indeks_pk[ke_teks(id)] = panjang(ini.baris_data) - 1;
        kembalikan Ok(benar);
    }

    // SELECT * FROM tabel WHERE kondisi
    fungsi pilih_di_mana(fungsi_predikat) {
        kembalikan saring(ini.baris_data, fungsi_predikat);
    }

    // UPDATE tabel SET ... WHERE id = ...
    fungsi perbarui_berdasarkan_id(id, data_baru) {
        misal key = ke_teks(id);
        jika bukan ada_kunci(ini.indeks_pk, key) {
            kembalikan Err("Galat: Data dengan ID " + key + " tidak ditemukan");
        }
        misal idx = ini.indeks_pk[key];
        ini.baris_data[idx] = data_baru;
        kembalikan Ok(benar);
    }
}

// -----------------------------------------------------------------
// 2. STRUKTUR DOKUMEN NoSQL (MongoDB-like Collection)
// -----------------------------------------------------------------
struktur KoleksiDokumen {
    nama_koleksi,
    dokumen,

    fungsi inisialisasi(nama) {
        ini.nama_koleksi = nama;
        ini.dokumen = [];
    }

    // db.collection.insertOne({...})
    fungsi sisip_satu(doc) {
        jika bukan ada_kunci(doc, "_id") {
            doc["_id"] = "doc_" + ke_teks(waktu()) + "_" + ke_teks(panjang(ini.dokumen) + 1);
        }
        tambah(ini.dokumen, doc);
        kembalikan Ok(doc["_id"]);
    }

    // db.collection.find({...})
    fungsi cari(kunci, nilai_target) {
        kembalikan saring(ini.dokumen, fungsi(item) {
            jika ada_kunci(item, kunci) {
                kembalikan item[kunci] == nilai_target;
            }
            kembalikan salah;
        });
    }

    // Agregasi / Map-Reduce pipeline (seperti MongoDB Aggregate)
    fungsi agregasi_total(kunci_angka) {
        kembalikan lipat(ini.dokumen, 0, fungsi(acc, item) {
            jika ada_kunci(item, kunci_angka) {
                kembalikan acc + item[kunci_angka];
            }
            kembalikan acc;
        });
    }
}

// =================================================================
// 3. EKSEKUSI PENGUJIAN DATABASE RELASIONAL (PostgreSQL Style)
// =================================================================
cetak("1️⃣  MENGUJI TABEL RELASIONAL (PostgreSQL Style):");
misal tbl_pengguna = TabelRelasional("pengguna", ["id", "nama", "email", "saldo"]);

tbl_pengguna.sisip({"id": 1, "nama": "Ahmad Dani", "email": "dani@widya.id", "saldo": 5000000});
tbl_pengguna.sisip({"id": 2, "nama": "Siti Nurhaliza", "email": "siti@widya.id", "saldo": 12500000});
tbl_pengguna.sisip({"id": 3, "nama": "Budi Santoso", "email": "budi@widya.id", "saldo": 750000});

// Query: SELECT * FROM pengguna WHERE saldo >= 5000000
misal pengguna_prioritas = tbl_pengguna.pilih_di_mana(fungsi(u) {
    kembalikan u["saldo"] >= 5000000;
});

cetak("   - Total pengguna:", panjang(tbl_pengguna.baris_data));
cetak("   - Pengguna Saldo >= 5 Juta (Query SELECT):");
untuk u dalam pengguna_prioritas {
    cetak("     * [" + ke_teks(u["id"]) + "] " + u["nama"] + " -> Rp " + ke_teks(u["saldo"]));
}
cetak("");

// =================================================================
// 4. EKSEKUSI PENGUJIAN DOKUMEN NoSQL (MongoDB Style)
// =================================================================
cetak("2️⃣  MENGUJI KOLEKSI NoSQL (MongoDB Style):");
misal koleksi_produk = KoleksiDokumen("katalog_produk");

koleksi_produk.sisip_satu({
    "nama": "Laptop WidyaBook Pro M3",
    "kategori": "Elektronik",
    "harga": 18000000,
    "tag": ["laptop", "developer", "widya"]
});

koleksi_produk.sisip_satu({
    "nama": "Mouse Nirkabel WidyaGlide",
    "kategori": "Aksesoris",
    "harga": 350000,
    "tag": ["mouse", "bluetooth"]
});

koleksi_produk.sisip_satu({
    "nama": "Monitor 4K WidyaVision 27\"",
    "kategori": "Elektronik",
    "harga": 6500000,
    "tag": ["monitor", "4k", "hdr"]
});

// Query MongoDB: find({ "kategori": "Elektronik" })
misal produk_elektronik = koleksi_produk.cari("kategori", "Elektronik");
misal total_nilai_aset = koleksi_produk.agregasi_total("harga");

cetak("   - Total dokumen produk:", panjang(koleksi_produk.dokumen));
cetak("   - Hasil Cari Kategori 'Elektronik':", panjang(produk_elektronik), "item.");
cetak("   - Total Nilai Aset Seluruh Produk (Aggregate Sum): Rp", total_nilai_aset);
cetak("");

// =================================================================
// 5. PENYIMPANAN PERSISTEN KE DISK (Storage Engine Serialization)
// =================================================================
cetak("3️⃣  PERSISTENSI PENYIMPANAN KE DISK (Storage Engine):");
misal state_database = {
    "_engine": "WidyaDB v1.0",
    "tabel_relasional": tbl_pengguna.baris_data,
    "koleksi_nosql": koleksi_produk.dokumen
};

misal json_db = ke_json(state_database, 2);
tulis_berkas("target/widyadb_backup.json", json_db);
cetak("   💾 Database berhasil ditulis ke disk: 'target/widyadb_backup.json'");

// Verifikasi pembacaan kembali dari disk
misal baca_kembali = dari_json(baca_berkas("target/widyadb_backup.json"));
cetak("   🔍 Verifikasi pembacaan database:", baca_kembali["_engine"]);
cetak("   ✅ Jumlah data relasional terbaca:", panjang(baca_kembali["tabel_relasional"]));
cetak("   ✅ Jumlah dokumen nosql terbaca:", panjang(baca_kembali["koleksi_nosql"]));

cetak("\n🎉 WIDYA-LANG TERBUKTI 100% MAMPU MEMBANGUN ENGINE DATABASE LENGKAP!");
