// ========================================================================
// 🌐 & ⚡ CONTOH 38: WIDYADNS & WIDYACIRCUITBREAKER
// ========================================================================

cetak("========================================================================");
cetak("✨ DEMO PILAR 1 & 2: WidyaDNS (Resolver) & WidyaCircuitBreaker (Resilience)");
cetak("========================================================================");

// ------------------------------------------------------------------------
// [1] WIDYADNS: IN-MEMORY DNS RESOLVER & CUSTOM ZONE RECORDS
// ------------------------------------------------------------------------
cetak("");
cetak("🌐 [1] Pengelolaan & Resolusi DNS Kustom In-Memory (WidyaDNS)...");

tetap server_dns = ServerDNS();

// Daftarkan rekod DNS
dns_tambah_rekod(server_dns, "widya-lang.org", "A", "192.168.1.100", 300.0);
dns_tambah_rekod(server_dns, "widya-lang.org", "TXT", "v=spf1 include:_spf.widya.org ~all", 600.0);
dns_tambah_rekod(server_dns, "api.widya-lang.org", "CNAME", "widya-lang.org", 300.0);

// Kueri rekod tipe A
tetap rekod_a = dns_kueri(server_dns, "widya-lang.org", "A");
cetak("  * Kueri DNS 'widya-lang.org' (Tipe A):");
untuk i dalam 0..panjang(rekod_a) - 1 {
    cetak("    -> Nilai IP :", rekod_a[i]["nilai"], "| TTL:", rekod_a[i]["ttl"]);
}

// Kueri rekod tipe CNAME
tetap rekod_cname = dns_kueri(server_dns, "api.widya-lang.org", "CNAME");
cetak("  * Kueri DNS 'api.widya-lang.org' (Tipe CNAME):");
cetak("    -> Alias Ke :", rekod_cname[0]["nilai"]);

// ------------------------------------------------------------------------
// [2] WIDYACIRCUITBREAKER: FAULT TOLERANCE MIKROSERVIS & FALLBACK
// ------------------------------------------------------------------------
cetak("");
cetak("⚡ [2] Pola Ketahanan Panggilan Mikroservis (WidyaCircuitBreaker)...");

// Buat Circuit Breaker dengan toleransi 2x gagal
tetap cb = PemutusSirkuit(2, 5000.0);

fungsi aksi_berbahaya() {
    // Simulasi layanan remote yang sedang error
    lempar("Layanan Remote 503 Service Unavailable");
}

fungsi aksi_cadangan() {
    kembalikan "Respon Fallback dari Cache Lokal (Graceful Degradation)";
}

cetak("  * Percobaan 1 Panggilan API...");
tetap r1 = eksekusi_dengan_pemutus(cb, aksi_berbahaya, aksi_cadangan);
cetak("    - Hasil :", r1);
cetak("    - Status:", status_pemutus(cb));

cetak("  * Percobaan 2 Panggilan API (Memicu Sirkuit Terbuka)...");
tetap r2 = eksekusi_dengan_pemutus(cb, aksi_berbahaya, aksi_cadangan);
cetak("    - Hasil :", r2);
cetak("    - Status:", status_pemutus(cb));

cetak("  * Percobaan 3 Panggilan API (Sirkuit Langsung Memotong)...");
tetap r3 = eksekusi_dengan_pemutus(cb, aksi_berbahaya, aksi_cadangan);
cetak("    - Hasil :", r3);

cetak("");
cetak("========================================================================");
cetak("✅ Selesai mengeksekusi WidyaDNS & WidyaCircuitBreaker!");
cetak("========================================================================");
