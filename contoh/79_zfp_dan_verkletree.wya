// ===================================================================
// CONTOH 79: ZFP FLOATING-POINT COMPRESSOR & VERKLE STATE TREES
// Widya-Lang Numerical Precision Compression & Vector Commitment Trees
// ===================================================================

cetak("=== DEMO WIDYA ZFP (SCIENTIFIC FLOATING-POINT COMPRESSOR) ===")
var data_sensor = [
    298.15, 298.22, 298.19, 298.35, 298.40,
    298.38, 298.50, 298.55, 298.52, 298.48,
    298.60, 298.65, 298.70, 298.68, 298.75
]
cetak("Jumlah titik data float : " + teks(panjang(data_sensor)))
cetak("Ukuran raw memori 64-bit: " + teks(panjang(data_sensor) * 8) + " bytes")

var comp_hex = zfp_kompres_array(data_sensor, 2)
cetak("Ukuran ZFP terkompresi  : " + teks(panjang(comp_hex) / 2) + " bytes")

var rasio = zfp_rasio_hemat(data_sensor, 2)
cetak("Efisiensi Penghematan   : " + teks(bulat(rasio * 100)) + "%")

var sensor_pulih = zfp_dekompres_array(comp_hex)
var selisih_maks = mutlak(sensor_pulih[0] - data_sensor[0])
cetak("Nilai awal sensor ke-1  : " + teks(sensor_pulih[0]) + " (Selisih: " + teks(selisih_maks) + ")")
pastikan(selisih_maks < 0.01, "Akurasi dekompresi presisi ZFP harus terpenuhi")

cetak("")
cetak("=== DEMO WIDYA VERKLE TREE (VECTOR COMMITMENT POLYNOMIAL TREE) ===")
var vt = PohonVerkle(16)

verkle_sisip(vt, "validator:0xAlpha", "STAKE:32_ETH")
verkle_sisip(vt, "validator:0xBeta", "STAKE:64_ETH")
verkle_sisip(vt, "validator:0xGamma", "STAKE:128_ETH")
verkle_sisip(vt, "validator:0xDelta", "STAKE:256_ETH")

var root_commitment = verkle_komitmen_root(vt)
cetak("Root Polynomial Vector Commitment: " + root_commitment)

var bukti_beta = verkle_buat_bukti(vt, "validator:0xBeta")
cetak("Status Keabsahan Bukti Verkle    : " + teks(bukti_beta.valid))
cetak("Kunci Terverifikasi             : " + bukti_beta.key)
cetak("Subvector Evaluation Hash        : " + bukti_beta.subvector_eval)
pastikan(bukti_beta.valid, "Bukti Verkle untuk 0xBeta harus sah")

cetak("")
cetak("✔ Seluruh pengujian ZFP Floating-Point Compressor dan Verkle Tree sukses 100%!")
