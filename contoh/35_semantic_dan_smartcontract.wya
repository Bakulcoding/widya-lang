// ========================================================================
// 🧠 & 📜 CONTOH 35: WIDYASEMANTICSEARCH & WIDYASMARTCONTRACT
// ========================================================================

cetak("========================================================================");
cetak("✨ DEMO PILAR 3 & 4: WidyaSemanticSearch & WidyaSmartContract");
cetak("========================================================================");

// ------------------------------------------------------------------------
// [1] WIDYASEMANTICSEARCH: TEMU KEMBALI VEKTOR & COSINE SIMILARITY
// ------------------------------------------------------------------------
cetak("");
cetak("🧠 [1] Pencarian Dokumen Semantik Berbasis Vektor (WidyaSemanticSearch)...");

tetap indeks = buat_indeks_vektor(3);

// Simpan dokumen dengan representasi vektor embedding (dimensi 3)
vektor_tambah(indeks, "doc_1", [0.9, 0.1, 0.2], "Panduan Belajar Bahasa Widya");
vektor_tambah(indeks, "doc_2", [0.1, 0.8, 0.7], "Resep Masakan Tradisional Rendang");
vektor_tambah(indeks, "doc_3", [0.85, 0.2, 0.1], "Arsitektur Compiler & Interpreter VM");
vektor_tambah(indeks, "doc_4", [0.0, 0.9, 0.85], "Tips Memasak Ayam Goreng Gurih");

// Kueri vektor untuk mencari topik seputar pemrograman/compiler
tetap kueri_vektor = [0.88, 0.15, 0.18];
tetap hasil_pencarian = vektor_kueri_kemiripan(indeks, kueri_vektor, 2);

cetak("  * Kueri Vektor Terkirim:", kueri_vektor);
cetak("  * Top 2 Dokumen Paling Mirip (Cosine Similarity):");
untuk i dalam 0..panjang(hasil_pencarian) - 1 {
    tetap item = hasil_pencarian[i];
    cetak("    [" + ke_teks(i + 1) + "] ID: " + item["id"] + " | Skor: " + ke_teks(item["kemiripan"]) + " | Judul: " + item["metadata"]);
}

// ------------------------------------------------------------------------
// [2] WIDYASMARTCONTRACT: BUKU BESAR AKUN & STATE MACHINE DETERMINISTIK
// ------------------------------------------------------------------------
cetak("");
cetak("📜 [2] Eksekusi State Machine Smart Contract (WidyaSmartContract)...");

// Inisialisasi buku besar akun
tetap buku_besar = buat_buku_besar({
    "0xAlice": 500.0,
    "0xBob": 100.0,
    "0xContractVault": 0.0
});

cetak("  * Saldo Awal 0xAlice:", buku_besar["saldo"]["0xAlice"]);
cetak("  * Saldo Awal 0xBob  :", buku_besar["saldo"]["0xBob"]);

// Transfer saldo langsung
transfer_saldo_ledger(buku_besar, "0xAlice", "0xBob", 50.0);
cetak("  * Saldo setelah transfer 50 token dari Alice ke Bob:");
cetak("    - 0xAlice :", buku_besar["saldo"]["0xAlice"]);
cetak("    - 0xBob   :", buku_besar["saldo"]["0xBob"]);

// Eksekusi Smart Contract deposit & state write
fungsi contract_deposit_handler(ledger, kontrak, pengirim) {
    tetap saldo_tercatat = ledger_get_state(ledger, kontrak, "total_deposit");
    misal deposit_saat_ini = 0.0;
    jika saldo_tercatat != nihil {
        deposit_saat_ini = saldo_tercatat;
    }
    
    // Tambah 100 ke vault
    ledger_set_state(ledger, kontrak, "total_deposit", deposit_saat_ini + 100.0);
    ledger_set_state(ledger, kontrak, "pendeposit_terakhir", pengirim);
    kembalikan "Deposit berhasil disimpan ke state storage!";
}

tetap res_tx = eksekusi_transaksi_ledger(
    buku_besar,
    "0xAlice",
    "0xContractVault",
    contract_deposit_handler,
    1000.0
);

cetak("  * Eksekusi Smart Contract Transaction Receipt:");
cetak("    - Sukses       :", res_tx["sukses"]);
cetak("    - Gas Terpakai :", res_tx["gas_terpakai"]);
cetak("    - Biaya Gas    :", res_tx["biaya_gas"]);
cetak("    - Respon Hasil :", res_tx["hasil"]);
cetak("    - Total Deposit di Storage Vault:", ledger_get_state(buku_besar, "0xContractVault", "total_deposit"));

cetak("");
cetak("========================================================================");
cetak("✅ Selesai mengeksekusi WidyaSemanticSearch & WidyaSmartContract!");
cetak("========================================================================");
