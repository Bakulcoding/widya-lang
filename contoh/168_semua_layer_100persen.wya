cetak("\n--- STEP 12: L1 BARE-METAL GPIO TOGGLE (L1 EMBEDDED) ---");
struktur _PinGPIO_Append { pin_num, mode, nilai }
fungsi _gpio_buat(pin, mode) {
    var p = _PinGPIO_Append(); p.pin_num = pin; p.mode = mode; p.nilai = 0;
    kembalikan p;
}
fungsi _gpio_tulis(p, v) { p.nilai = v; kembalikan v; }
fungsi _gpio_baca(p) { kembalikan p.nilai; }
var _pin = _gpio_buat(5, "Output");
_gpio_tulis(_pin, 1);
pastikan(_gpio_baca(_pin) == 1);
_gpio_tulis(_pin, 0);
pastikan(_gpio_baca(_pin) == 0);
cetak("[STEP 12 OK] L1 BARE METAL GPIO TOGGLE LULUS");

cetak("\n--- STEP 13: L4 JARINGAN MESH DHT LOOKUP (L4 NETWORK) ---");
struktur _DHTMeshNode_Append { node_id, alamat, routing_table, data_store }
fungsi _dht_buat(id, addr) {
    var n = _DHTMeshNode_Append();
    n.node_id = id; n.alamat = addr; n.routing_table = {}; n.data_store = {};
    kembalikan n;
}
fungsi _dht_simpan(n, kunci, nilai) { n.data_store[kunci] = nilai; kembalikan benar; }
fungsi _dht_cari(n, kunci) {
    var v = n.data_store[kunci];
    jika v == nihil { kembalikan { "ketemu": salah, "nilai": nihil } };
    kembalikan { "ketemu": benar, "nilai": v };
}
var _dht_node = _dht_buat("widya_node_001", "10.0.0.1:7070");
_dht_simpan(_dht_node, "widya/contract/erc20/token_wid", { "nama": "WID", "decimals": 18, "total_supply": 10000000000 });
var _dht_res = _dht_cari(_dht_node, "widya/contract/erc20/token_wid");
pastikan(_dht_res["ketemu"] == benar);
pastikan(_dht_res["nilai"]["nama"] == "WID");
pastikan(_dht_res["nilai"]["total_supply"] == 10000000000);
cetak("[STEP 13 OK] L4 MESH DHT LOOKUP LULUS");

cetak("\n--- STEP 14: L5 WIDYADB SPATIAL JOIN (L5 DATA STORAGE) ---");
struktur _TabelWidyaDB_Append { nama_tabel, baris, indeks }
fungsi _tbl_buat(nama) {
    var t = _TabelWidyaDB_Append(); t.nama_tabel = nama; t.baris = []; t.indeks = {};
    kembalikan t;
}
fungsi _tbl_sisip(t, baris) {
    tambah(t.baris, baris);
    var idx = panjang(t.baris) - 1;
    var idbar = baris["id"];
    jika idbar != nihil { t.indeks[ke_teks(idbar)] = idx };
    kembalikan benar;
}
fungsi _tbl_spatial_join(tA, tB, kunci_geom_a, kunci_geom_b, max_jarak) {
    var hasil = [];
    untuk a in tA.baris {
        untuk b in tB.baris {
            var ga = a[kunci_geom_a];
            var gb = b[kunci_geom_b];
            jika ga != nihil dan gb != nihil {
                var dx = ga["x"] - gb["x"];
                var dy = ga["y"] - gb["y"];
                var jarak = dx * dx + dy * dy;
                jika jarak <= max_jarak * max_jarak {
                    tambah(hasil, { "a": a, "b": b, "jarak_kuadrat": jarak });
                }
            }
        }
    }
    kembalikan hasil;
}
var _toko = _tbl_buat("toko_retail");
var _konsumen = _tbl_buat("konsumen_aktif");
_tbl_sisip(_toko, { "id": 1, "nama": "Toko_Pusat_Jakarta", "geom": { "x": 106.8456, "y": -6.2088 } });
_tbl_sisip(_konsumen, { "id": 9001, "nama": "Budi_W", "geom": { "x": 106.8457, "y": -6.20885 } });
_tbl_sisip(_konsumen, { "id": 9002, "nama": "Siti_R", "geom": { "x": 110.0, "y": -7.0 } });
var _join_res = _tbl_spatial_join(_toko, _konsumen, "geom", "geom", 0.5);
pastikan(panjang(_join_res) >= 1);
pastikan(_join_res[0]["a"]["nama"] == "Toko_Pusat_Jakarta");
pastikan(_join_res[0]["b"]["id"] == 9001);
cetak("[STEP 14 OK] L5 WIDYADB SPATIAL JOIN DENGAN JARAK MAKS LULUS");

