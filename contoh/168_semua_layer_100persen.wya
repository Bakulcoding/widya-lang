_wos_cap.nama_kemampuan = "SYSTEM_KERNEL_INTERRUPT"; _wos_cap.level_akses = 5;
_wos_cap.daftar_izin = [_PerizinanSD_Append("MEM", 0, 4294967296), _PerizinanSD_Append("CPU", 0, 16)];
_wos_cap.status_approval = "APPROVED";
var _wos_r = _wos_append_syscall(_wos_k, _wos_cap, 128, { "syscall_id": 1 });
pastikan(_wos_r["status"] == "ISR_DISPATCH_OK");
pastikan(_wos_r["vector"] == 128);
pastikan(_wos_r["hasil_isr"] == "OK_SYSCALL");
var _wos_r2 = _wos_append_syscall(_wos_k, _wos_cap, 32, { "tick_ms": 1 });
pastikan(_wos_r2["nama_isr"] == "TIMER_0x20");
pastikan(_wos_k.heap_limit_mb == 128);
cetak("[STEP 10 OK] WIDYA OS INTERRUPT SYSCALL KAL CAPABILITY CHECK LULUS");

cetak("\n--- STEP 11: INTEGRASI L2 → L3 → L6 (INTERRUPT → CGROUP → FEDAVG CUDA) ---");
var _integrasi_step_l2 = _idt_dispatch(_demo_idt, 32, { "tick_ms": 1 });
pastikan(_integrasi_step_l2 == "ISR_TIMER_0X20");
var _integrasi_cg_limit_cpu_ok = _cg.cpu_max_ms > 0;
pastikan(_integrasi_cg_limit_cpu_ok == benar);
var _list_fed_cuda_shards = [];
