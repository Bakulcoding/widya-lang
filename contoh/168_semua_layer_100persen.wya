untuk _s in _l6_idx {
    _list_fed_cuda_shards = _list_fed_cuda_shards + [{ "id": "H100_GPU_" + ke_teks(_s), "mem_gb": 80, "status": "ACTIVE" }];
}
var _fed_l6_ok = panjang(_list_fed_cuda_shards) == 8;
pastikan(_fed_l6_ok == benar);
cetak("INTEGRASI_L2_L3_L6_OK");
cetak("  L2 Interrupt Timer 0x20 -> status: " + _integrasi_step_l2);
