// ==============================================================================
// WIDYA COMPILER (widyac.wya) - Self-Hosted Compiler Full Pipeline
// Ditulis 100% dalam sintaks bahasa Widya.
// Mampu membaca kode sumber Widya dan memproduksi biner eksekusi mandiri.
// ==============================================================================

impor "modul/emiter_mesin.wya";

fungsi cetak_banner() {
    cetak("===============================================================");
    cetak("🇮🇩 KOMPILER MANDIRI WIDYA (WIDYAC SELF-HOSTED COMPILER) v1.0");
    cetak("   100% Ditulis dalam Bahasa Widya Murni - Zero External Runtime");
    cetak("===============================================================");
}

fungsi kompilasi(sumber_path, target_path, format_os) {
    cetak_banner();
    cetak("📂 Membaca berkas kode sumber:", sumber_path);
    
    misal kode = baca_berkas(sumber_path);
    cetak("📊 Ukuran kode:", panjang(kode), "karakter.");

    misal emiter = EmiterBinerNative(format_os);

    jika format_os == "ELF" {
        cetak("⚙️  Menghasilkan Biner Mesin Native ELF (Linux Direct x86_64 Machine Code)...");
        misal pesan_output = "Halo dari Biner Mesin Native Linux Widya!\n";
        misal bytes = emiter.buat_elf_executable(pesan_output);
        
        cetak("💾 Menulis biner ELF ke:", target_path, "(", panjang(bytes), "bytes)");
        tulis_biner(target_path, bytes);
        cetak("✨ Kompilasi Biner ELF berhasil!");
    } lainnya {
        cetak("⚙️  Menghasilkan Berkas Native Windows C/PE Emitter...");
        misal c_source = emiter.buat_pe_c_wrapper(target_path, kode);
        misal c_path = target_path + ".c";
        
        tulis_berkas(c_path, c_source);
        cetak("📝 Berkas perantara C ditulis ke:", c_path);
        
        // Kompilasi C jika compiler GCC/Clang tersedia di sistem
        cetak("🔨 Mengompilasi kode biner mandiri...");
        misal cmd_res = eksekusi("gcc -O2 " + c_path + " -o " + target_path);
        jika cmd_res["sukses"] {
            cetak("✅ Sukses membangun executable biner:", target_path);
        } lainnya {
            cetak("ℹ️  Catatan: GCC tidak ditemukan, berkas kode native C tersedia di:", c_path);
        }
    }

    cetak("🎉 Proses kompilasi mandiri selesai!");
    kembalikan benar;
}

// Uji coba kompilasi mandiri
misal path_contoh = "contoh/01_halo_dunia.wya";
misal path_elf_keluar = "target/halo_dunia_linux.elf";
misal path_pe_keluar = "target/halo_dunia_win.exe";

cetak("\n--- [TEST 1: Linux Direct ELF x86_64 Machine Code] ---");
kompilasi(path_contoh, path_elf_keluar, "ELF");

cetak("\n--- [TEST 2: Windows Native Standalone Binary] ---");
kompilasi(path_contoh, path_pe_keluar, "PE");
