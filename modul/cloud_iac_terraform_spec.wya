// Modul Infrastructure-as-Code Spec & Policy-as-Code (Terraform & Open Policy Agent)

fungsi buat_spesifikasi_iac(nama_proyek) {
    kembalikan {
        "proyek": nama_proyek,
        "sumber_daya": {},
        "kebijakan_keamanan": []
    };
}

fungsi iac_tambah_resource(spec, resource_type, resource_id, atribut_map) {
    spec["sumber_daya"][resource_id] = {
        "tipe": resource_type,
        "konfigurasi": atribut_map
    };
    kembalikan spec;
}

fungsi iac_tambah_aturan_kebijakan(spec, nama_aturan, fungsi_validator) {
    spec["kebijakan_keamanan"] = tambah(spec["kebijakan_keamanan"], {
        "nama": nama_aturan,
        "validator": fungsi_validator
    });
    kembalikan spec;
}

fungsi iac_evaluasi_kepatuhan_kebijakan(spec) {
    var pelanggaran = [];
    var res_keys = kunci(spec["sumber_daya"]);
    
    untuk r_id dalam res_keys {
        var res = spec["sumber_daya"][r_id];
        
        // Aturan default 1: Akses publik tidak boleh diaktifkan sembarangan
        jika (ada_kunci(res["konfigurasi"], "public_access") dan res["konfigurasi"]["public_access"] == benar) {
            pelanggaran = tambah(pelanggaran, "Pelanggaran Keamanan: Resource " + r_id + " membuka akses publik langsung!");
        }
        
        // Aturan default 2: Enkripsi saat istirahat (encryption at rest) wajib aktif
        jika (ada_kunci(res["konfigurasi"], "encrypted") dan res["konfigurasi"]["encrypted"] == salah) {
            pelanggaran = tambah(pelanggaran, "Pelanggaran Kepatuhan: Resource " + r_id + " tidak mengaktifkan enkripsi storage!");
        }
    }
    
    kembalikan {
        "total_resource": panjang(res_keys),
        "apakah_patuh": panjang(pelanggaran) == 0,
        "daftar_pelanggaran": pelanggaran
    };
}

fungsi iac_hasilkan_hcl_terraform(spec) {
    var hcl = "# Terraform HCL Auto-Generated by Widya-Lang IaC Engine\n";
    var res_keys = kunci(spec["sumber_daya"]);
    
    untuk r_id dalam res_keys {
        var res = spec["sumber_daya"][r_id];
        hcl = hcl + "resource \"" + res["tipe"] + "\" \"" + r_id + "\" {\n";
        
        var attr_keys = kunci(res["konfigurasi"]);
        untuk a_k dalam attr_keys {
            var val_str = ke_teks(res["konfigurasi"][a_k]);
            hcl = hcl + "  " + a_k + " = \"" + val_str + "\"\n";
        }
        hcl = hcl + "}\n\n";
    }
    
    kembalikan hcl;
}
