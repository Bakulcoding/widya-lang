// Modul Observabilitas, Metrik Prometheus & Probe K8s Widya-Lang
// Mengintegrasikan Format Prometheus, Counter, Gauge, Liveness & Readiness Probes

fungsi buat_registry_metrik(nama_aplikasi) {
    kembalikan {
        "app": nama_aplikasi,
        "counters": {},
        "gauges": {},
        "status_layanan": "STARTING"
    };
}

fungsi prometheus_tambah_counter(registry, nama_metrik, nilai_tambah) {
    jika (!ada_kunci(registry["counters"], nama_metrik)) {
        registry["counters"][nama_metrik] = 0.0;
    }
    registry["counters"][nama_metrik] = registry["counters"][nama_metrik] + nilai_tambah;
    kembalikan registry["counters"][nama_metrik];
}

fungsi prometheus_set_gauge(registry, nama_metrik, nilai_gauge) {
    registry["gauges"][nama_metrik] = nilai_gauge;
    kembalikan nilai_gauge;
}

fungsi prometheus_ekspor_teks(registry) {
    var output = "# HELP app_metrics Generated by Widya Observability\n";
    
    var k_counter = kunci(registry["counters"]);
    var i = 0;
    selama (i < panjang(k_counter)) {
        var k = k_counter[i];
        output = output + k + "{app=\"" + registry["app"] + "\"} " + teks(registry["counters"][k]) + "\n";
        i = i + 1;
    }
    
    var k_gauge = kunci(registry["gauges"]);
    var j = 0;
    selama (j < panjang(k_gauge)) {
        var g = k_gauge[j];
        output = output + g + "{app=\"" + registry["app"] + "\"} " + teks(registry["gauges"][g]) + "\n";
        j = j + 1;
    }
    
    kembalikan output;
}

fungsi k8s_liveness_probe(registry) {
    kembalikan {
        "status": 200.0,
        "alive": benar,
        "app": registry["app"]
    };
}

fungsi k8s_readiness_probe(registry) {
    var siap = registry["status_layanan"] == "READY";
    var status_code = 503.0;
    jika (siap) {
        status_code = 200.0;
    }
    kembalikan {
        "status": status_code,
        "ready": siap,
        "state": registry["status_layanan"]
    };
}
