// Modul Manajemen Baterai Kendaraan Listrik BMS & CANopen CiA 454

fungsi bms_estimasi_kondisi_baterai(tegangan_sel_mv_list, arus_ampere, suhu_celsius) {
    // Estimasi SoC (State of Charge) & SoH (State of Health)
    var n = panjang(tegangan_sel_mv_list);
    var v_total = 0.0;
    var v_min = 99999.0;
    var v_max = 0.0;
    var i = 0;
    
    selama (i < n) {
        var v = tegangan_sel_mv_list[i];
        v_total = v_total + v;
        jika (v < v_min) { v_min = v; }
        jika (v > v_max) { v_max = v; }
        i = i + 1;
    }
    
    var selisih_delta_mv = v_max - v_min;
    var butuh_balancing = selisih_delta_mv > 30.0; // >30mV butuh active cell balancing
    
    var termal_status = "NORMAL";
    jika (suhu_celsius > 55.0) {
        termal_status = "WARNING_OVERHEAT";
    }
    
    kembalikan {
        "jumlah_sel": n,
        "tegangan_pack_volt": v_total / 1000.0,
        "tegangan_sel_min_mv": v_min,
        "tegangan_sel_max_mv": v_max,
        "delta_balancing_mv": selisih_delta_mv,
        "perlu_balancing": butuh_balancing,
        "arus_a": arus_ampere,
        "suhu_c": suhu_celsius,
        "status_termal": termal_status
    };
}
